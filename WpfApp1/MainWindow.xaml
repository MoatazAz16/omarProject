<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="#FF4B0000" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid RenderTransformOrigin="0.51,0.619">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="378*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" Grid.ColumnSpan="3">

            <Label Content="Main Menue"  Width="125" Margin="335,0,333.6,0" Height="40" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="#FFEA6161" Offset="1"/>
                    </LinearGradientBrush>
                </Label.Background>
            </Label>

            <Button Content="users" x:Name="Save" Click="users_Click" Width="200" Margin="297,0,296.6,0" Height="40" FontSize="20"/>
            <Button Content="products" x:Name="Add" Click="products_Click" Width="200" Margin="297,0,296.6,0" Height="40" FontSize="20"/>

            <Button Content="category" x:Name="Cancel" Click="category_Click" Width="200" Height="40" Margin="297,0,296.6,0"  FontSize="20"/>

        </StackPanel>



    </Grid>
</Window>
